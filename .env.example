# Create a Telegram bot via @BotFather and place the token here.
BOT_TOKEN=

# Comma-separated numeric Telegram user IDs allowed to open the admin panel.
# Get your numeric ID from @userinfobot.
ADMIN_IDS=

# Public channel username or numeric chat ID. The bot must be an administrator
# in the channel for reliable membership checks.
CHANNEL_ID=@mm2hubscripts
CHANNEL_URL=https://t.me/mm2hubscripts

# SQLite database path (the directory is created automatically).
DATABASE_PATH=data/liberium.sqlite3

# Optional bot settings.
LOG_LEVEL=INFO
